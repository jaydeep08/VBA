// Function to generate an ICS file content and return a Blob URL
function generateICSFile(eventData) {
    const icsContent = `
BEGIN:VCALENDAR
VERSION:2.0
BEGIN:VEVENT
UID:${eventData.id}@example.com
DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').split('.')[0]}Z
DTSTART:${eventData.startDateTime.replace(/[-:]/g, '').split('.')[0]}Z
DTEND:${eventData.endDateTime.replace(/[-:]/g, '').split('.')[0]}Z
SUMMARY:${eventData.title}
DESCRIPTION:${eventData.description}
LOCATION:${eventData.location}
URL:${eventData.eventUrl || ''}
END:VEVENT
END:VCALENDAR
    `.trim();

    // Create a Blob from the ICS content
    const blob = new Blob([icsContent], { type: 'text/calendar' });

    // Generate a downloadable URL
    return URL.createObjectURL(blob);
}

// Function to transform raw event data into the desired object format
function transformEventData(rawEventData) {
    return rawEventData.map(event => {
        // Convert start and end times to local time zone
        const startTimeLocal = new Date(event.startDateTime).toLocaleString();
        const endTimeLocal = new Date(event.endDateTime).toLocaleString();

        // Generate ICS file link
        const icsFileLink = generateICSFile(event);

        // Construct the custom event object
        return {
            title: event.title,
            description: event.description,
            image: event.image || 'No image available', // Fallback for missing images
            location: event.location || 'Location not specified',
            startTime: startTimeLocal,
            endTime: endTimeLocal,
            icsLink: icsFileLink, // The dynamically created ICS file link
            eventLink: event.eventUrl || '#', // The event link
        };
    });
}

