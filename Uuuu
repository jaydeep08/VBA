import { useEffect, useRef } from "react";

const useMutationObserver = (callback, options) => {
  const observerRef = useRef(null);

  useEffect(() => {
    const observer = new MutationObserver(callback); // Pass callback to observer
    observerRef.current = observer;

    return () => {
      if (observerRef.current) observerRef.current.disconnect(); // Cleanup
    };
  }, [callback]); // Dependencies

  const observe = (targetNode) => {
    if (observerRef.current && targetNode) {
      observerRef.current.observe(targetNode, options); // Observe with options
    }
  };

  return { observe };
};

export default useMutationObserver;

import React, { useRef } from "react";
import useMutationObserver from "./useMutationObserver";

const MyComponent = () => {
  const containerRef = useRef(null);

  const mutationCallback = (mutationsList) => {
    mutationsList.forEach((mutation) => {
      if (mutation.type === "childList") {
        console.log("Child added or removed:", mutation);
      }
    });
  };

  const { observe } = useMutationObserver(mutationCallback, {
    childList: true, // Watch for child nodes being added or removed
    subtree: true,   // Include all descendants of the target node
  });

  React.useEffect(() => {
    if (containerRef.current) {
      observe(containerRef.current); // Start observing the container
    }
  }, [observe]);

  return <div ref={containerRef}>Observe this container</div>;
};

export default MyComponent;
