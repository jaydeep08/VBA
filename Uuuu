// Example: Dynamically add links to the page
transformedEvents.forEach(event => {
    const link = document.createElement('a');
    link.href = event.icsLink;
    link.download = `${event.title}.ics`;
    link.textContent = `Download ${event.title} ICS`;
    document.body.appendChild(link);
    document.body.appendChild(document.createElement('br'));

    // Add a clickable link to the event
    const eventLink = document.createElement('a');
    eventLink.href = event.eventLink;
    eventLink.textContent = `View ${event.title}`;
    eventLink.target = '_blank'; // Open in a new tab
    document.body.appendChild(eventLink);
    document.body.appendChild(document.createElement('br'));
});
