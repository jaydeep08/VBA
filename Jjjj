import { zonedTimeToUtc, utcToZonedTime, format } from "date-fns-tz";

/**
 * Convert a local time to UTC in US Pacific Time Zone.
 * @param {string} localTime - Local time in ISO 8601 format or as a Date object.
 * @returns {string} - Converted UTC time in ISO 8601 format.
 */
const convertLocalToUSPacificUTC = (localTime) => {
  const localDate = new Date(localTime); // Parse the local time
  const usPacificTimeZone = "America/Los_Angeles"; // US Pacific Time Zone

  // Convert local time to US Pacific Time Zone
  const pacificDate = utcToZonedTime(localDate, usPacificTimeZone);

  // Convert US Pacific Time Zone to UTC
  const utcDate = zonedTimeToUtc(pacificDate, usPacificTimeZone);

  // Format as ISO 8601 string
  return utcDate.toISOString();
};

// Example Usage
const localTime = "2024-12-02T10:30:00"; // Local time
const utcTime = convertLocalToUSPacificUTC(localTime);
console.log("Converted UTC Time:", utcTime);
