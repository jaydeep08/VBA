function safeParseObjectString(input: string): any | null {
  if (!input || typeof input !== 'string') return null;

  // First try standard JSON
  try {
    return JSON.parse(input);
  } catch (_) {}

  try {
    // Replace unquoted keys (basic handling)
    let safe = input.replace(/([{,]\s*)([a-zA-Z0-9_]+)\s*:/g, '$1"$2":');

    // Replace single-quoted string values with double-quoted ones
    // e.g., 'John' -> "John" but avoids changing content inside double quotes
    safe = safe.replace(/'([^']*)'/g, (_, val) => `"${val.replace(/"/g, '\\"')}"`);

    return JSON.parse(safe);
  } catch (e) {
    console.error('Parsing failed:', e);
    return null;
  }
}
