/* General form input and select styling */
input,
select {
  @apply form-input w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#141414] focus:outline-0 focus:ring-0 border border-[#dbdbdb] bg-neutral-50 focus:border-[#dbdbdb] h-14 placeholder:text-neutral-500 p-[15px] text-base font-normal leading-normal;
}

/* Two-column form layout */
.form-grid {
  @apply grid grid-cols-1 md:grid-cols-2 gap-6 px-4 py-3;
}

.form-group {
  @apply flex flex-col;
}

/* Label styling */
.form-group label {
  @apply text-[#141414] text-base font-medium leading-normal pb-2;
}

/* Toggle row */
.toggle-row {
  @apply grid grid-cols-1 md:grid-cols-2 gap-6 px-4 py-3;
}

.toggle-item {
  @apply flex items-center justify-between bg-neutral-50 min-h-14 p-2 rounded-xl border border-[#dbdbdb];
}

.toggle-label {
  @apply text-[#141414] text-base font-normal leading-normal flex-1 truncate;
}

.toggle-switch {
  @apply relative flex h-[31px] w-[51px] cursor-pointer items-center rounded-full border-none bg-[#ededed] p-0.5 has-[:checked]:justify-end has-[:checked]:bg-black;
}

.toggle-thumb {
  @apply h-full w-[27px] rounded-full bg-white;
  box-shadow: rgba(0, 0, 0, 0.15) 0px 3px 8px, rgba(0, 0, 0, 0.06) 0px 3px 1px;
}

/* Submit button */
.submit-btn {
  @apply flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-10 px-4 flex-1 bg-black text-neutral-50 text-sm font-bold leading-normal tracking-[0.015em];
}

/* Modal overlay */
.modal-overlay {
  @apply fixed inset-0 bg-black bg-opacity-30 z-40 flex items-center justify-center;
}

/* Modal container */
.modal {
  @apply bg-white rounded-xl shadow-xl max-w-xl w-full p-6 space-y-4 z-50;
}

/* Modal header */
.modal h2 {
  @apply text-xl font-bold text-[#141414];
}

/* Modal buttons */
.modal-buttons {
  @apply flex justify-end gap-4 pt-4;
}

/* Progress modal */
.progress-modal {
  @apply text-center;
}

.progress-bar-container {
  @apply w-full bg-gray-200 rounded;
}

.progress-bar-fill {
  @apply h-2 bg-black rounded;
  transition: width 0.3s ease-in-out;
}

/* Utility buttons */
.btn {
  @apply px-4 py-2 rounded-xl font-semibold text-sm;
}

.btn-primary {
  @apply bg-black text-white hover:bg-neutral-800;
}

.btn-secondary {
  @apply bg-gray-200 text-black hover:bg-gray-300;
}
