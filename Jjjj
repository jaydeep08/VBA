function main(workbook: ExcelScript.Workbook): Record<string, object[]> {

  const sheetNames: string[] = [
    "User Activity",
    "User Pathway Summary",
    "Shared Items",
    "Published Pathway Summary",
    "Published Pathway Details"
  ];

  let result: Record<string, object[]> = {};

  for (let name of sheetNames) {

    const sheet = workbook.getWorksheet(name);
    if (!sheet) continue;

    const usedRange = sheet.getUsedRange();
    if (!usedRange) continue;

    const values = usedRange.getValues();
    if (values.length < 4) continue;

    // Row 4 = headers (index 3)
    const headers = values[3] as (string | number | boolean)[];

    // Row 5 onward = data
    const dataRows = values.slice(4);

    const formattedData: object[] = dataRows
      .filter(row => row.some(cell => cell !== null && cell !== ""))
      .map(row => {

        let rowObject: { [key: string]: string | number | boolean | null } = {};

        headers.forEach((header, index) => {
          const headerName = header ? header.toString() : `Column${index}`;
          rowObject[headerName] = row[index] as string | number | boolean | null;
        });

        return rowObject;
      });

    result[name] = formattedData;
  }

  return result;
}
