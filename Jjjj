import React, { useEffect, useRef, useState } from "react";
import DataGrid from "devextreme-react/data-grid";
import { Button } from "devextreme-react/button";

const employees = [
  { id: 1, name: "John", department: "HR", age: 28 },
  { id: 2, name: "Jane", department: "Finance", age: 31 },
  { id: 3, name: "Mike", department: "IT", age: 26 },
  { id: 4, name: "Sara", department: "HR", age: 35 },
  { id: 5, name: "Alex", department: "IT", age: 40 },
];

const MyGrid = () => {
  const gridRef = useRef(null);
  const [data, setData] = useState(employees);

  // 🔹 Load grid state from DB (on mount)
  useEffect(() => {
    const loadGridState = async () => {
      // Simulated API call
      const response = await fetch("/api/getGridState");
      if (response.ok) {
        const saved = await response.json();
        applyGridState(saved);
      }
    };
    loadGridState();
  }, []);

  // 🔹 Apply saved state
  const applyGridState = (state) => {
    const grid = gridRef.current?.instance;
    if (!grid || !state) return;

    // Restore selected rows
    grid.selectRows(state.selectedRowKeys || [], false);

    // Restore filters
    (state.columns || []).forEach((col) => {
      if (col.filterValue !== undefined && col.filterValue !== null) {
        grid.columnOption(col.dataField, "filterValue", col.filterValue);
      } else {
        grid.columnOption(col.dataField, "filterValue", null);
      }
    });

    grid.refresh();
  };

  // 🔹 Save grid state (on button click)
  const saveGridState = async () => {
    const grid = gridRef.current?.instance;
    if (!grid) return;

    const state = {
      selectedRowKeys: grid.getSelectedRowKeys(),
      columns: grid.getVisibleColumns().map((col) => ({
        dataField: col.dataField,
        filterValue: col.filterValue || null,
      })),
    };

    // Simulated API call
    await fetch("/api/saveGridState", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(state),
    });

    alert("✅ Grid state saved!");
  };

  return (
    <div style={{ padding: 20 }}>
      <Button text="Save Grid" onClick={saveGridState} type="default" />
      <DataGrid
        ref={gridRef}
        dataSource={data}
        keyExpr="id"
        showBorders={true}
        selection={{ mode: "multiple" }}
        filterRow={{ visible: true }}
      />
    </div>
  );
};

export default MyGrid;
