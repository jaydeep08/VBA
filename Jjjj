const renderChart = (structuredData: any[]) => {
  const months = Array.from({ length: 12 }, (_, i) => i);

  return (
    <div style={{ display: "flex", flexDirection: "column", width: "100%" }}>
      {structuredData.map((swimlineData, swimIndex) => {
        const totalRows = swimlineData.subSwimlines.reduce(
          (sum: number, sub: any) => sum + sub.rows.length,
          0
        );

        return (
          <div
            key={swimIndex}
            style={{ display: "flex", borderBottom: "2px solid #ccc", minHeight: totalRows * 40 }}
          >
            {/* Left Section (20%) */}
            <div style={{ width: "20%", borderRight: "1px solid #ccc" }}>
              {/* Swimline Title */}
              <div
                style={{
                  padding: "10px",
                  fontWeight: "bold",
                  height: totalRows * 40,
                  display: "flex",
                  alignItems: "center",
                  borderBottom: "1px solid #ddd",
                  backgroundColor: "#f0f0f0"
                }}
              >
                {swimlineData.swimline}
              </div>

              {/* SubSwimline Labels */}
              <div style={{ position: "relative", top: `-${totalRows * 40}px` }}>
                {swimlineData.subSwimlines.map((sub, subIndex) => (
                  <div key={subIndex}>
                    {sub.rows.map((_, rowIndex) => (
                      <div
                        key={rowIndex}
                        style={{
                          height: "40px",
                          paddingLeft: "15px",
                          display: "flex",
                          alignItems: "center",
                          backgroundColor: rowIndex % 2 === 0 ? "#fff" : "#f9f9f9",
                          borderBottom: "1px solid #eee"
                        }}
                      >
                        {rowIndex === 0 ? sub.name : ""}
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            </div>

            {/* Right Section (80%) - Timeline */}
            <div style={{ width: "80%", position: "relative" }}>
              {/* Vertical timeline grid */}
              {months.map((month) => (
                <div
                  key={month}
                  style={{
                    position: "absolute",
                    left: `${(month / 12) * 100}%`,
                    top: 0,
                    bottom: 0,
                    width: "1px",
                    backgroundColor: "#ddd",
                    zIndex: 0,
                  }}
                />
              ))}

              {/* Render pointer rows */}
              {swimlineData.subSwimlines.map((sub, subIndex) =>
                sub.rows.map((row, rowIndex) => (
                  <div
                    key={`${subIndex}-${rowIndex}`}
                    style={{
                      height: "40px",
                      position: "relative",
                      backgroundColor: rowIndex % 2 === 0 ? "#fff" : "#f4f9ff",
                      borderBottom: "1px solid #ccc",
                    }}
                  >
                    {row.map((item: any, itemIndex: number) => {
                      const date = new Date(item.Startdate);
                      const leftPercent =
                        ((date.getMonth() + date.getDate() / 30) / 12) * 100;

                      return (
                        <div
                          key={itemIndex}
                          style={{
                            position: "absolute",
                            left: `${leftPercent}%`,
                            transform: "translateX(-50%)",
                            backgroundColor: "#4287f5",
                            padding: "4px 8px",
                            borderRadius: "4px",
                            color: "#fff",
                            fontSize: "12px",
                            whiteSpace: "nowrap",
                            zIndex: 2,
                          }}
                        >
                          {item.Title}
                        </div>
                      );
                    })}
                  </div>
                ))
              )}
            </div>
          </div>
        );
      })}
    </div>
  );
};
