const leftRefs = useRef([]);
const rightRefs = useRef([]);

useEffect(() => {
  const syncHeights = () => {
    for (let i = 0; i < leftRefs.current.length; i++) {
      const leftEl = leftRefs.current[i];
      const rightEl = rightRefs.current[i];

      if (leftEl && rightEl) {
        const maxHeight = Math.max(leftEl.offsetHeight, rightEl.offsetHeight);
        leftEl.style.height = `${maxHeight}px`;
        rightEl.style.height = `${maxHeight}px`;
      }
    }
  };

  syncHeights();

  // Observe resize inside the container
  const observer = new ResizeObserver(syncHeights);
  observer.observe(document.querySelector('.chart-container'));

  return () => observer.disconnect();
}, []);
