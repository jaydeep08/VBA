const MS_IN_60_DAYS = 1000 * 60 * 60 * 24 * 60;

const groupDataByRows = (data: any[]) => {
  return data.reduce((acc: any, item) => {
    const swimline = item.Swimline;
    const subSwimline = item.SubSwimline;
    const itemStart = new Date(item.Startdate).getTime();

    if (!acc[swimline]) acc[swimline] = {};
    if (!acc[swimline][subSwimline]) {
      acc[swimline][subSwimline] = {
        SubSwimline: subSwimline,
        Rows: [],
      };
    }

    const rows = acc[swimline][subSwimline].Rows;
    let placed = false;

    for (let row of rows) {
      let hasOverlap = row.some((rItem: any) => {
        const rDate = new Date(rItem.Startdate).getTime();
        return Math.abs(itemStart - rDate) < MS_IN_60_DAYS;
      });

      if (!hasOverlap) {
        row.push(item);
        placed = true;
        break;
      }
    }

    if (!placed) {
      rows.push([item]);
    }

    return acc;
  }, {});
};



const renderChart = (groupedData: any) => {
  const chartStart = new Date("2023/01/01").getTime();
  const chartEnd = new Date("2023/12/31").getTime();
  const chartRange = chartEnd - chartStart;

  return (
    <div style={{ display: "flex", flexDirection: "column", fontFamily: "sans-serif" }}>
      {Object.keys(groupedData).map((swimline, swimlineIndex) => (
        <div
          key={swimlineIndex}
          style={{
            display: "flex",
            borderBottom: "2px solid #ccc",
            marginBottom: "20px",
          }}
        >
          {/* Swimline Label */}
          <div
            style={{
              width: "20%",
              backgroundColor: "#f0f0f0",
              padding: "10px",
              borderRight: "1px solid #ccc",
              fontWeight: "bold",
            }}
          >
            {swimline}
          </div>

          {/* Swimline Content */}
          <div style={{ width: "80%" }}>
            {Object.keys(groupedData[swimline]).map((subSwimline, subIndex) => {
              const subData = groupedData[swimline][subSwimline];

              return (
                <div key={subIndex} style={{ marginBottom: "10px" }}>
                  {/* SubSwimline Row */}
                  <div style={{ display: "flex" }}>
                    <div
                      style={{
                        width: "20%",
                        backgroundColor: "#e8e8e8",
                        padding: "5px 10px",
                        borderRight: "1px solid #ccc",
                        fontStyle: "italic",
                      }}
                    >
                      {subSwimline}
                    </div>

                    <div style={{ width: "80%", position: "relative" }}>
                      {subData.Rows.map((row: any[], rowIndex: number) => (
                        <div
                          key={rowIndex}
                          style={{
                            height: "40px",
                            position: "relative",
                            backgroundColor: rowIndex % 2 === 0 ? "#fafafa" : "#ffffff",
                            borderBottom: "1px dashed #ccc",
                          }}
                        >
                          {row.map((item: any, itemIndex: number) => {
                            const startTime = new Date(item.Startdate).getTime();
                            const leftPercent = ((startTime - chartStart) / chartRange) * 100;

                            return (
                              <div
                                key={itemIndex}
                                style={{
                                  position: "absolute",
                                  left: `${leftPercent}%`,
                                  transform: "translateX(-50%)",
                                  backgroundColor: "#2196f3",
                                  padding: "3px 8px",
                                  borderRadius: "4px",
                                  color: "#fff",
                                  fontSize: "12px",
                                  whiteSpace: "nowrap",
                                  top: "50%",
                                  transformOrigin: "top left",
                                  transform: "translate(-50%, -50%)",
                                  zIndex: 2,
                                }}
                              >
                                {item.Title}
                              </div>
                            );
                          })}
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  );
};

