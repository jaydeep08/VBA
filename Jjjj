function groupDataWithRows(data: any[]) {
  const result: any[] = [];

  // Group by Swimline → SubSwimline
  const grouped: Record<string, Record<string, any[]>> = {};

  for (const item of data) {
    const swimline = item.Swimline;
    const subSwimline = item.SubSwimline;

    if (!grouped[swimline]) {
      grouped[swimline] = {};
    }
    if (!grouped[swimline][subSwimline]) {
      grouped[swimline][subSwimline] = [];
    }

    grouped[swimline][subSwimline].push(item);
  }

  // Build the hierarchical structure with rows
  for (const swimlineKey in grouped) {
    const swimlineObj = {
      swimline: swimlineKey,
      subSwimlines: [] as any[]
    };

    const subGroup = grouped[swimlineKey];

    for (const subKey in subGroup) {
      const items = subGroup[subKey];

      // Sort items by Startdate
      items.sort((a, b) => new Date(a.Startdate).getTime() - new Date(b.Startdate).getTime());

      const rows: any[][] = [];

      for (const item of items) {
        const itemDate = new Date(item.Startdate).getTime();
        let placed = false;

        for (const row of rows) {
          const lastItem = row[row.length - 1];
          const lastDate = new Date(lastItem.Startdate).getTime();
          if (itemDate - lastDate >= 1000 * 60 * 60 * 24 * 60) {
            row.push(item);
            placed = true;
            break;
          }
        }

        if (!placed) {
          rows.push([item]);
        }
      }

      swimlineObj.subSwimlines.push({
        name: subKey,
        rows: rows
      });
    }

    result.push(swimlineObj);
  }

  return result;
}
