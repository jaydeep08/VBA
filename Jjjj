function groupDataWithRows(data: any[]) {
  const result: any[] = [];

  const grouped = data.reduce((acc, item) => {
    if (!acc[item.Swimline]) acc[item.Swimline] = {};
    if (!acc[item.Swimline][item.SubSwimline]) acc[item.Swimline][item.SubSwimline] = [];
    acc[item.Swimline][item.SubSwimline].push(item);
    return acc;
  }, {} as Record<string, Record<string, any[]>>);

  Object.entries(grouped).forEach(([swimline, subSwimlines]) => {
    const swimlineObj = {
      swimline,
      subSwimlines: [] as any[]
    };

    Object.entries(subSwimlines).forEach(([subName, items]) => {
      // Sort items by start date
      const sortedItems = items.sort(
        (a, b) => new Date(a.Startdate).getTime() - new Date(b.Startdate).getTime()
      );

      // Allocate to rows
      const rows: any[][] = [];

      sortedItems.forEach(item => {
        const start = new Date(item.Startdate).getTime();
        let placed = false;

        for (const row of rows) {
          const lastItem = row[row.length - 1];
          const lastDate = new Date(lastItem.Startdate).getTime();
          if (start - lastDate >= 1000 * 60 * 60 * 24 * 60) {
            row.push(item);
            placed = true;
            break;
          }
        }

        if (!placed) {
          rows.push([item]);
        }
      });

      swimlineObj.subSwimlines.push({
        name: subName,
        rows
      });
    });

    result.push(swimlineObj);
  });

  return result;
}


const renderChart = (structuredData: any[]) => {
  const months = Array.from({ length: 12 }, (_, i) => i);

  return (
    <div style={{ width: "100%", position: "relative" }}>
      {/* Render vertical monthly lines */}
      <div style={{ position: "absolute", top: 0, bottom: 0, width: "100%", zIndex: 0 }}>
        {months.map((month) => (
          <div
            key={month}
            style={{
              position: "absolute",
              left: `${(month / 12) * 100}%`,
              top: 0,
              bottom: 0,
              width: "1px",
              backgroundColor: "#ddd",
            }}
          />
        ))}
      </div>

      {/* Swimline level */}
      {structuredData.map((swimlineData, swimIndex) => (
        <div
          key={swimIndex}
          style={{
            display: "flex",
            borderBottom: "2px solid #ccc",
            marginBottom: "20px",
          }}
        >
          {/* Left column: Swimline title */}
          <div style={{ width: "20%", padding: "10px", fontWeight: "bold" }}>
            {swimlineData.swimline}
          </div>

          {/* Right column: SubSwimlines with rows */}
          <div style={{ width: "80%" }}>
            {swimlineData.subSwimlines.map((sub, subIndex) => (
              <div key={subIndex} style={{ marginBottom: "10px" }}>
                {/* SubSwimline title */}
                <div style={{ fontWeight: "bold", padding: "5px 0" }}>{sub.name}</div>

                {/* Timeline rows */}
                {sub.rows.map((row, rowIndex) => (
                  <div
                    key={rowIndex}
                    style={{
                      position: "relative",
                      height: "40px",
                      backgroundColor: rowIndex % 2 === 0 ? "#f9f9f9" : "#e6f0ff",
                      display: "flex",
                      alignItems: "center",
                      borderBottom: "1px solid #ccc",
                    }}
                  >
                    {row.map((item: any, itemIndex: number) => {
                      const date = new Date(item.Startdate);
                      const leftPercent =
                        ((date.getMonth() + date.getDate() / 30) / 12) * 100;

                      return (
                        <div
                          key={itemIndex}
                          style={{
                            position: "absolute",
                            left: `${leftPercent}%`,
                            transform: "translateX(-50%)",
                            backgroundColor: "#4287f5",
                            padding: "4px 8px",
                            borderRadius: "4px",
                            color: "#fff",
                            fontSize: "12px",
                            whiteSpace: "nowrap",
                            zIndex: 1,
                          }}
                        >
                          {item.Title}
                        </div>
                      );
                    })}
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  );
};

