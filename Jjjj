.form-wrapper {
  font-family: Inter, "Noto Sans", sans-serif;
}

.form-container {
  max-width: 640px;
  margin: 2rem auto;
  padding: 2rem;
  background-color: #fefefe;
  border-radius: 12px;
  border: 1px solid #e0e0e0;
}

.form-title {
  font-size: 1.75rem;
  font-weight: bold;
  margin-bottom: 1.5rem;
}

.form-group {
  margin-bottom: 1rem;
  display: flex;
  flex-direction: column;
}

.form-group label {
  margin-bottom: 0.4rem;
  font-weight: 500;
}

.form-group input {
  height: 3rem;
  padding: 0 1rem;
  border: 1px solid #dbdbdb;
  border-radius: 10px;
  background: #fafafa;
  font-size: 1rem;
}

.form-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 1rem 0;
}

.submit-button {
  width: 100%;
  background-color: black;
  color: white;
  padding: 0.75rem;
  border-radius: 10px;
  font-weight: bold;
  font-size: 1rem;
  cursor: pointer;
  border: none;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.modal {
  background: white;
  padding: 2rem;
  border-radius: 12px;
  width: 90%;
  max-width: 500px;
  text-align: left;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.25);
}

.modal-title {
  font-size: 1.3rem;
  font-weight: bold;
  margin-bottom: 1rem;
}

.modal-summary {
  list-style: none;
  padding-left: 0;
  margin-bottom: 1.5rem;
}

.modal-summary li {
  margin-bottom: 0.5rem;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 1rem;
}

.modal-actions button {
  padding: 0.6rem 1rem;
  border-radius: 8px;
  border: none;
  font-weight: 600;
  cursor: pointer;
}

.modal-actions button:first-child {
  background: #e0e0e0;
}

.modal-actions button:last-child {
  background: black;
  color: white;
}

.progress-bar-container {
  height: 8px;
  width: 100%;
  background: #dbdbdb;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 1rem;
}

.progress-bar {
  height: 100%;
  background: black;
  transition: width 0.3s ease;
}
