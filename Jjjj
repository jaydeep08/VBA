* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.chart-container {
  display: grid;
  grid-template-columns: 200px 1fr;
  grid-template-rows: 80px 1fr;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
}

.y-axis {
  grid-column: 1;
  grid-row: 2;
  overflow-y: auto;
  background: #f4f4f4;
  border-right: 1px solid #ccc;
}

.category-block {
  border-bottom: 1px solid #ddd;
  padding: 10px;
}

.category-block.has-sub {
  background: #fafafa;
}

.category-name {
  font-weight: bold;
  margin-bottom: 8px;
}

.subcategory-list .subcategory {
  padding-left: 15px;
  font-size: 14px;
  color: #555;
}

.header {
  grid-column: 2;
  grid-row: 1;
  overflow-x: auto;
  background: #f8f9fa;
  border-bottom: 1px solid #ccc;
}

.months {
  display: flex;
}

.month {
  min-width: 150px;
  text-align: center;
  border-right: 1px solid #ddd;
  padding: 10px;
  position: relative;
}

.flags {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 5px;
}

.flag {
  background: #007bff;
  color: white;
  padding: 2px 6px;
  margin: 2px 0;
  font-size: 10px;
  border-radius: 4px;
}

.plot-area {
  grid-column: 2;
  grid-row: 2;
  overflow: auto;
  background: #fff;
}

.plot-row {
  border-bottom: 1px solid #eee;
  padding: 10px 0;
}

.plot-sub-row,
.plot-single-row {
  display: flex;
  margin-bottom: 5px;
}

.plot-point {
  min-width: 150px;
  height: 30px;
  border: 1px dashed #ccc;
  margin-right: 2px;
}
