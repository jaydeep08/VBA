/* Base Input Styles */
input,
select {
  @apply form-input w-full min-w-0 flex-1 resize-none overflow-hidden rounded-xl text-[#141414] focus:outline-0 focus:ring-0 border border-[#dbdbdb] bg-neutral-50 focus:border-[#dbdbdb] h-14 placeholder:text-neutral-500 p-[15px] text-base font-normal leading-normal;
}

/* Modal Overlay */
.modal-overlay {
  @apply fixed inset-0 bg-black bg-opacity-30 z-40 flex items-center justify-center;
}

/* Modal Container */
.modal {
  @apply bg-white rounded-xl shadow-xl max-w-xl w-full p-6 space-y-4 z-50;
}

/* Modal Title */
.modal h2 {
  @apply text-xl font-bold text-[#141414];
}

/* Modal Button Group */
.modal-buttons {
  @apply flex justify-end gap-4 pt-4;
}

/* Progress Modal Styles */
.progress-modal {
  @apply text-center;
}

.progress-bar-container {
  @apply w-full bg-gray-200 rounded;
}

.progress-bar-fill {
  @apply h-2 bg-black rounded;
  transition: width 0.3s ease-in-out;
}

/* Button Styles */
.btn {
  @apply px-4 py-2 rounded-xl font-semibold text-sm;
}

.btn-primary {
  @apply bg-black text-white hover:bg-neutral-800;
}

.btn-secondary {
  @apply bg-gray-200 text-black hover:bg-gray-300;
}
