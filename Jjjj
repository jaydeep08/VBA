function main(workbook: ExcelScript.Workbook) {

  const sheetNames = [
    "User Activity",
    "User Pathway Summary",
    "Shared Items",
    "Published Pathway Summary",
    "Published Pathway Details"
  ];

  let result = [];

  for (let name of sheetNames) {

    const sheet = workbook.getWorksheet(name);
    if (!sheet) continue;

    const usedRange = sheet.getUsedRange();
    if (!usedRange) continue;

    const values = usedRange.getValues();
    if (values.length < 4) continue;

    const headers = values[3];
    const dataRows = values.slice(4);

    let formattedData = [];

    for (let row of dataRows) {

      if (!row.some(cell => cell !== null && cell !== "")) continue;

      let rowObject = {};

      for (let i = 0; i < headers.length; i++) {

        const headerName = headers[i]
          ? headers[i].toString()
          : `Column${i}`;

        rowObject[headerName] = row[i];
      }

      formattedData.push(rowObject);
    }

    result.push({
      sheetName: name,
      data: formattedData
    });
  }

  return result;
}
