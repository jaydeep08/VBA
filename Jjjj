function safeParseObjectString(input: string): any | null {
  if (!input || typeof input !== 'string') return null;

  // First try standard JSON
  try {
    return JSON.parse(input);
  } catch (_) {}

  try {
    let safe = input;

    // Remove trailing commas before } or ]
    safe = safe.replace(/,\s*(?=[}\]])/g, '');

    // Quote unquoted keys (only alphanumerics and underscores)
    safe = safe.replace(/([{,]\s*)([a-zA-Z0-9_]+)\s*:/g, '$1"$2":');

    // Replace single-quoted string values with double quotes (preserving contents)
    safe = safe.replace(/'([^']*)'/g, (_, val) => `"${val.replace(/"/g, '\\"')}"`);

    return JSON.parse(safe);
  } catch (e) {
    console.error('Parsing failed:', e);
    return null;
  }
}
