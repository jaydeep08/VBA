function groupDataWithRows(data: any[]): any[] {
  const result: any[] = [];
  const swimlineMap: Record<string, any> = {};

  data.forEach((item) => {
    const swimline = item.Swimline;
    const subSwimline = item.SubSwimline;

    if (!swimlineMap[swimline]) {
      swimlineMap[swimline] = {
        swimline,
        subSwimlines: {}
      };
    }

    if (!swimlineMap[swimline].subSwimlines[subSwimline]) {
      swimlineMap[swimline].subSwimlines[subSwimline] = [];
    }

    swimlineMap[swimline].subSwimlines[subSwimline].push(item);
  });

  Object.keys(swimlineMap).forEach((swimlineKey) => {
    const subSwimlinesArr: any[] = [];

    const subMap = swimlineMap[swimlineKey].subSwimlines;

    Object.keys(subMap).forEach((subKey) => {
      const items = subMap[subKey];

      // Sort by Startdate
      items.sort((a, b) => new Date(a.Startdate).getTime() - new Date(b.Startdate).getTime());

      const rows: any[][] = [];

      items.forEach((item) => {
        const itemDate = new Date(item.Startdate).getTime();
        let placed = false;

        for (const row of rows) {
          const lastItem = row[row.length - 1];
          const lastDate = new Date(lastItem.Startdate).getTime();

          if (itemDate - lastDate >= 1000 * 60 * 60 * 24 * 60) { // >= 60 days
            row.push(item);
            placed = true;
            break;
          }
        }

        if (!placed) {
          rows.push([item]);
        }
      });

      subSwimlinesArr.push({
        name: subKey,
        rows
      });
    });

    result.push({
      swimline: swimlineKey,
      subSwimlines: subSwimlinesArr
    });
  });

  return result;
}
